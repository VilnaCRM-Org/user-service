# NanoClaw Dev Cycle Workflow — Configuration
# Copy to .nanoclaw/workflows/config.env and adjust as needed.
# This file is NOT loaded automatically; source it explicitly if you want overrides.

# Maximum number of fix attempts before giving up on CI failures
NANOCLAW_WORKFLOW_MAX_FIX_ATTEMPTS=3

# Log verbosity: debug | info | warn
NANOCLAW_WORKFLOW_LOG_LEVEL=info

# Color output: auto | always | never
# auto = colors when stdout is a terminal, none when piped
NANOCLAW_WORKFLOW_COLORS=auto

# Override repo root detection (auto-detected from .git if empty)
NANOCLAW_WORKFLOW_REPO_ROOT=

# Git remote used for gh commands
NANOCLAW_WORKFLOW_GH_REMOTE=origin

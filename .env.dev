# Dev-only localhost allow-list. NEVER ships to prod (the prod image bakes .env,
# whose CORS_ALLOW_ORIGIN default is the fail-closed '(?!)' deny-all regex).
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

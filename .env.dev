# LocalStack KMS key created by infrastructure/docker/php/init-aws.sh
TWO_FACTOR_KMS_KEY_ID=alias/user-service-two-factor

###> nelmio/cors-bundle ###
# Dev-only localhost allow-list. NEVER ships to prod (the prod image bakes .env,
# whose CORS_ALLOW_ORIGIN default is the fail-closed '(?!)' deny-all regex).
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

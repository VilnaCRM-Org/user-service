{
	admin localhost:2019
	auto_https off
	servers {
		trusted_proxies static {$TRUSTED_PROXY_CIDRS:127.0.0.1/32}
		trusted_proxies_strict
	}
	frankenphp {
		worker {
			file /srv/app/public/index.php
			env APP_RUNTIME Runtime\FrankenPhpSymfony\Runtime
			env APP_ENV prod
			env APP_DEBUG 0
		}
	}
}

:80 {
	log {
		output stderr
		format filter {
			request>uri query {
				replace code REDACTED
				replace state REDACTED
			}
			wrap json
		}
	}

	root * /srv/app/public
	encode zstd gzip
	header -Server
	vulcain
	php_server {
		env APP_ENV prod
		env APP_DEBUG 0
	}
	file_server
}
